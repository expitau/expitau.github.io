---
import Layout from "../../layouts/main.astro";
import Tag from "../../components/Tag.astro";
import { formatDate } from "../../util/helpers";

import { blog } from "../../util/content";
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";

export function getStaticPaths() {
    return blog.map((post) => {
        return { params: { slug: post.id } };
    });
}

const { slug } = Astro.params;
const post = blog.find((post) => post.id === slug);
if (!post) {
    return new Response("Not found", { status: 404 });
}
const { Content } = await render(post);
---

<Layout title="Blog">
    
    <a
        href="/blog"
        class="backarrow"
        style="display: flex; flex-direction: row; align-items: center; gap: 1rem; position: fixed; top: 2rem; left: 3rem; text-decoration: none;"
    >
        <Icon type="arrowback" width="18px" height="18px" />
        Blog
    </a>
    <div
        style="width: 90%; max-width: 50rem; padding-bottom: 12rem; padding-top: 6rem"
    >
        <h1 style="text-align: center; margin-bottom: 0">{post.data.title}</h1>
        <h2 style="text-align: center; margin-top: 0">
            {formatDate(post.data.date, true)}
        </h2>
        <div
            style="display: flex; flex-direction: row; justify-content: center; gap: 0.5rem"
        >
            {post.data.tags && post.data.tags.map((tag) => <Tag name={tag} />)}
        </div>
        <br />
        <article>
            <Content />
        </article>
        <br />
    </div>
</Layout>
