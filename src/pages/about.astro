---
import Layout from "../layouts/main.astro";
import Icon from "../components/Icon.astro";

import * as AboutContent from "../content/static/about.md"

const { Content } = AboutContent;
---

<Layout title="Blog">
    <style>
        .backarrow {
            color: var(--text-secondary);
            text-decoration: none;
        }

        .backarrow:hover {
            color: var(--text);
            transition:
                color 0.2s ease-in-out,
                transform 0.2s ease-in-out;
        }

        .backarrow svg {
            transition: transform 0.2s ease-in-out;
        }

        .backarrow:hover svg {
            transform: translateX(-3px);
        }
    </style>
    
    <a
        href="/"
        class="backarrow"
        style="display: flex; flex-direction: row; align-items: center; gap: 1rem; position: fixed; top: 2rem; left: 3rem;"
    >
        <Icon type="arrowback" width="18px" height="18px" />
        Home
    </a>
    <div
        style="width: 90%; max-width: 50rem; padding-bottom: 12rem; padding-top: 6rem"
    >
        <h1 style="text-align: center; margin-bottom: 0">About me</h1>
        <br />
        <article>
            <Content />
        </article>
        <br />
    </div>
</Layout>
